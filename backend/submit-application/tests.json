{
  "tests": [
    {
      "name": "Submit valid student application",
      "method": "POST",
      "path": "/",
      "body": {"name": "Иван Петров", "email": "ivan@example.com", "type": "student"},
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Reject invalid type",
      "method": "POST",
      "path": "/",
      "body": {"name": "Тест", "email": "test@example.com", "type": "unknown"},
      "expectedStatus": 400,
      "bodyMatcher": "partial",
      "expectedBody": {"error": "Заполните все поля корректно"}
    },
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    }
  ]
}
